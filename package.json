{
  "name": "@michelangelo-land/sdk",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "Official Michelangelo Land SDK — dynamic OAuth 2.1 + PKCE auth with in-memory tokens, typed client generated from the OpenAPI contract (api.michelangelo.land/v1/openapi.json).",
  "license": "MIT",
  "author": "Michelangelo Land <sardo@michelangelo.land>",
  "homepage": "https://docs.michelangelo.land",
  "bugs": {
    "url": "https://github.com/michelangelo-land/sdk/issues"
  },
  "keywords": [
    "typescript",
    "sdk",
    "oauth2",
    "pkce",
    "openapi",
    "api-client",
    "fetch",
    "michelangelo-land"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michelangelo-land/sdk.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "react-native": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node-loopback": {
      "types": "./dist/node-loopback.d.ts",
      "import": "./dist/node-loopback.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "openapi",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "sync:openapi": "node scripts/sync-openapi.mjs",
    "contract": "node scripts/contract-check.mjs",
    "prepublishOnly": "npm run build",
    "example:node-login": "tsx examples/node-login.ts"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18"
  }
}
